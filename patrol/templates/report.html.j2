<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>巡检报告 - {{ project_name }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
               background: #f5f7fa; padding: 20px; color: #333; }
        .container { max-width: 1000px; margin: 0 auto; background: #fff;
                     border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); overflow: hidden; }
        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                  padding: 30px; color: #fff; }
        .header h1 { font-size: 24px; margin-bottom: 8px; }
        .header .meta { opacity: 0.9; font-size: 14px; }
        .score-section { display: flex; justify-content: center; padding: 30px;
                        border-bottom: 1px solid #f0f0f0; }
        .score-circle { width: 120px; height: 120px; border-radius: 50%;
                       display: flex; flex-direction: column; align-items: center;
                       justify-content: center; font-size: 36px; font-weight: bold;
                       {% if statistics.health_score >= 90 %}
                       background: #f6ffed; border: 4px solid #52c41a; color: #52c41a;
                       {% elif statistics.health_score >= 70 %}
                       background: #fffbe6; border: 4px solid #faad14; color: #faad14;
                       {% else %}
                       background: #fff2f0; border: 4px solid #ff4d4f; color: #ff4d4f;
                       {% endif %} }
        .score-circle small { font-size: 12px; font-weight: normal; color: #999; }
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                 gap: 16px; padding: 20px 30px; border-bottom: 1px solid #f0f0f0; }
        .stat-card { text-align: center; padding: 16px; border-radius: 8px; background: #fafafa; }
        .stat-card .number { font-size: 28px; font-weight: bold; }
        .stat-card .label { font-size: 12px; color: #999; margin-top: 4px; }
        .stat-card.danger .number { color: #ff4d4f; }
        .stat-card.warning .number { color: #faad14; }
        .stat-card.success .number { color: #52c41a; }
        .section { padding: 20px 30px; }
        .section h2 { font-size: 18px; margin-bottom: 16px; padding-bottom: 8px;
                     border-bottom: 2px solid #667eea; display: inline-block; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
        th { background: #fafafa; padding: 12px 8px; text-align: left; font-weight: 600;
             border-bottom: 2px solid #f0f0f0; }
        td { padding: 10px 8px; border-bottom: 1px solid #f0f0f0; }
        tr:hover { background: #fafafa; }
        .badge { padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; }
        .badge-critical { background: #fff2f0; color: #ff4d4f; border: 1px solid #ffccc7; }
        .badge-warning { background: #fffbe6; color: #faad14; border: 1px solid #ffe58f; }
        .badge-normal { background: #f6ffed; color: #52c41a; border: 1px solid #b7eb8f; }
        .footer { padding: 20px 30px; text-align: center; color: #999; font-size: 12px;
                  border-top: 1px solid #f0f0f0; }
        .empty-state { text-align: center; padding: 40px; color: #999; }
        @media (max-width: 600px) {
            .stats { grid-template-columns: repeat(2, 1fr); }
            table { font-size: 12px; }
            .header { padding: 20px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>&#x1f50d; 巡检报告</h1>
            <div class="meta">
                <span>项目：{{ project_name }} ({{ env }})</span> &nbsp;|&nbsp;
                <span>时间：{{ timestamp | format_datetime }}</span>
            </div>
        </div>

        <div class="score-section">
            <div class="score-circle">
                {{ statistics.health_score }}
                <small>健康评分</small>
            </div>
        </div>

        <div class="stats">
            <div class="stat-card">
                <div class="number">{{ statistics.total_targets }}</div>
                <div class="label">监控目标数</div>
            </div>
            <div class="stat-card success">
                <div class="number">{{ statistics.up_targets }}</div>
                <div class="label">在线</div>
            </div>
            <div class="stat-card danger">
                <div class="number">{{ statistics.down_targets }}</div>
                <div class="label">离线</div>
            </div>
            <div class="stat-card">
                <div class="number">{{ statistics.total_items }}</div>
                <div class="label">巡检项</div>
            </div>
            <div class="stat-card danger">
                <div class="number">{{ statistics.critical_items }}</div>
                <div class="label">严重</div>
            </div>
            <div class="stat-card warning">
                <div class="number">{{ statistics.warning_items }}</div>
                <div class="label">警告</div>
            </div>
        </div>

        {% set abnormal_items = inspection_results | selectattr("status", "ne", "正常") | list %}
        {% if abnormal_items %}
        <div class="section">
            <h2>&#x1f534; 异常项</h2>
            <table>
                <thead>
                    <tr>
                        <th>实例</th>
                        <th>指标</th>
                        <th>当前值</th>
                        <th>阈值</th>
                        <th>级别</th>
                        <th>说明</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in abnormal_items %}
                    <tr>
                        <td>{{ item.target_instance }}</td>
                        <td>{{ item.metric_name }}</td>
                        <td><strong>{{ item.current_value }}</strong></td>
                        <td>{{ item.threshold_value }}</td>
                        <td>
                            <span class="badge badge-{{ 'critical' if item.status == '严重' else 'warning' }}">
                                {{ item.status }}
                            </span>
                        </td>
                        <td>{{ item.detail }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="section">
            <div class="empty-state">&#x1f389; 所有巡检项均正常，无异常发现</div>
        </div>
        {% endif %}

        {% if active_alerts %}
        <div class="section">
            <h2>&#x26a0;&#xfe0f; 活跃告警</h2>
            <table>
                <thead>
                    <tr><th>告警名称</th><th>实例</th><th>严重程度</th><th>触发时间</th></tr>
                </thead>
                <tbody>
                    {% for alert in active_alerts %}
                    <tr>
                        <td>{{ alert.labels.alertname }}</td>
                        <td>{{ alert.labels.instance }}</td>
                        <td><span class="badge badge-{{ alert.labels.severity }}">{{ alert.labels.severity }}</span></td>
                        <td>{{ alert.activeAt }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

        <div class="section">
            <h2>&#x2705; 各模块概况</h2>
            <table>
                <thead>
                    <tr><th>模块</th><th>目标数</th><th>在线</th><th>巡检项</th><th>异常</th></tr>
                </thead>
                <tbody>
                    {% for plugin_name, targets in targets_summary.items() %}
                    <tr>
                        <td>{{ plugin_name }}</td>
                        <td>{{ targets | length }}</td>
                        <td>{{ targets | selectattr("state", "eq", "up") | list | length }}</td>
                        <td>{{ inspection_results | selectattr("plugin_name", "eq", plugin_name) | list | length }}</td>
                        <td>{{ inspection_results | selectattr("plugin_name", "eq", plugin_name) | selectattr("status", "ne", "正常") | list | length }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="footer">
            巡检系统自动生成 | {{ timestamp | format_datetime }}
        </div>
    </div>
</body>
</html>